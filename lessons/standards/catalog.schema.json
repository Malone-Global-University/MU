{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maloneuniversity.org/lessons/standards/catalog.schema.json",
  "title": "MGU Departmental Lesson Catalog — Compatibility Schema v1",
  "description": "Schema for catalog.json as consumed by the November 2026 MGU departmental lesson dashboard. Additional cross-record checks are performed by tools/validate_lessons.py.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "departments"],
  "properties": {
    "schemaVersion": {"const": 1},
    "departments": {
      "type": "array",
      "items": {"$ref": "#/$defs/department"}
    }
  },
  "$defs": {
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "maxLength": 100
    },
    "name": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "department": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "courses"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "name": {"$ref": "#/$defs/name"},
        "description": {"$ref": "#/$defs/description"},
        "courses": {"type": "array", "items": {"$ref": "#/$defs/course"}}
      }
    },
    "course": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "lessons"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "name": {"$ref": "#/$defs/name"},
        "description": {"$ref": "#/$defs/description"},
        "lessons": {"type": "array", "items": {"$ref": "#/$defs/lesson"}}
      }
    },
    "lesson": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "file"],
      "properties": {
        "id": {"$ref": "#/$defs/slug"},
        "title": {"$ref": "#/$defs/name"},
        "file": {
          "type": "string",
          "pattern": "^content/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*/[a-z0-9]+(?:-[a-z0-9]+)*\\.md$"
        },
        "minutes": {"type": "integer", "minimum": 1, "maximum": 600},
        "level": {"enum": ["Beginner", "Intermediate", "Advanced"]}
      }
    }
  }
}
